{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Sundarban",
  "author": "Aditya Subramanian",
  "themes": [
    {
      "name": "Sundarban",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",

        "border": "#2E2A2C",
        "border.variant": "#242424",
        "border.focused": "#00CC98",
        "border.selected": "#00CC98",
        "border.transparent": "#00000000",
        "border.disabled": "#2E2A2C",

        "background": "#1E1E1E",
        "surface.background": "#1E1E1E",
        "elevated_surface.background": "#222222",
        "drop_target.background": "#39FF1420",

        "element.background": "#2A2A2A",
        "element.hover": "#2E2A2C",
        "element.active": "#3A3438",
        "element.selected": "#3A3438",
        "element.disabled": "#2A2A2A",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#2E2A2C",
        "ghost_element.active": "#3A3438",
        "ghost_element.selected": "#3A3438",
        "ghost_element.disabled": "#00000000",

        "text": "#E4E4E4",
        "text.muted": "#9AA999",
        "text.placeholder": "#6E666A",
        "text.disabled": "#52494E",
        "text.accent": "#39FF14",

        "icon": "#E4E4E4",
        "icon.muted": "#9AA999",
        "icon.disabled": "#52494E",
        "icon.placeholder": "#6E666A",
        "icon.accent": "#39FF14",

        "status_bar.background": "#1E1E1E",
        "title_bar.background": "#1E1E1E",
        "title_bar.inactive_background": "#181818",
        "toolbar.background": "#181818",
        "tab_bar.background": "#1E1E1E",
        "tab.inactive_background": "#1E1E1E",
        "tab.active_background": "#181818",
        "panel.background": "#1E1E1E",
        "panel.focused_border": "#00CC98",
        "pane.focused_border": "#00CC98",
        "pane_group.border": "#2E2A2C",
        "scrollbar.thumb.background": "#52494E80",
        "scrollbar.thumb.hover_background": "#52494E",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "search.match_background": "#FFF15040",

        "editor.background": "#181818",
        "editor.foreground": "#E4E4E4",
        "editor.gutter.background": "#181818",
        "editor.subheader.background": "#1E1E1E",
        "editor.active_line.background": "#222222",
        "editor.highlighted_line.background": "#2A2A2A",
        "editor.line_number": "#52494E",
        "editor.active_line_number": "#E4E4E4",
        "editor.invisible": "#3A3438",
        "editor.wrap_guide": "#2A2A2A",
        "editor.active_wrap_guide": "#3A3438",
        "editor.indent_guide": "#2A2A2A",
        "editor.indent_guide_active": "#52494E",
        "editor.document_highlight.read_background": "#52494E60",
        "editor.document_highlight.write_background": "#52494E90",
        "editor.document_highlight.bracket_background": "#00CC9830",

        "terminal.background": "#181818",
        "terminal.foreground": "#E4E4E4",
        "terminal.bright_foreground": "#F5F5F5",
        "terminal.dim_foreground": "#9AA999",
        "terminal.ansi.black": "#181818",
        "terminal.ansi.red": "#FC6767",
        "terminal.ansi.green": "#A3C585",
        "terminal.ansi.yellow": "#cc8c3c",
        "terminal.ansi.blue": "#00a1ff",
        "terminal.ansi.magenta": "#9E95C7",
        "terminal.ansi.cyan": "#00CC98",
        "terminal.ansi.white": "#E4E4E4",
        "terminal.ansi.bright_black": "#52494E",
        "terminal.ansi.bright_red": "#FC6767",
        "terminal.ansi.bright_green": "#39FF14",
        "terminal.ansi.bright_yellow": "#FFF150",
        "terminal.ansi.bright_blue": "#00a1ff",
        "terminal.ansi.bright_magenta": "#9E95C7",
        "terminal.ansi.bright_cyan": "#C7F9AC",
        "terminal.ansi.bright_white": "#F5F5F5",

        "link_text.hover": "#00CC98",

        "vim.normal.background": "#39FF14",
        "vim.normal.foreground": "#181818",
        "vim.insert.background": "#00a1ff",
        "vim.insert.foreground": "#181818",
        "vim.replace.background": "#E4E4E4",
        "vim.replace.foreground": "#181818",
        "vim.visual.background": "#FFB86C",
        "vim.visual.foreground": "#181818",
        "vim.visual_line.background": "#FFB86C",
        "vim.visual_line.foreground": "#181818",
        "vim.visual_block.background": "#FFB86C",
        "vim.visual_block.foreground": "#181818",

        "error": "#FC6767",
        "error.background": "#FC676720",
        "error.border": "#FC6767",
        "warning": "#FFF150",
        "warning.background": "#FFF15020",
        "warning.border": "#FFF150",
        "info": "#C7F9AC",
        "info.background": "#C7F9AC20",
        "info.border": "#C7F9AC",
        "hint": "#9AA999",
        "hint.background": "#9AA99920",
        "hint.border": "#9AA999",
        "success": "#39FF14",
        "success.background": "#39FF1420",
        "success.border": "#39FF14",
        "created": "#C7F9AC",
        "created.background": "#C7F9AC20",
        "created.border": "#C7F9AC",
        "deleted": "#FC6767",
        "deleted.background": "#FC676720",
        "deleted.border": "#FC6767",
        "modified": "#FFF150",
        "modified.background": "#FFF15020",
        "modified.border": "#FFF150",
        "conflict": "#FFB86C",
        "conflict.background": "#FFB86C20",
        "conflict.border": "#FFB86C",
        "renamed": "#00a1ff",
        "renamed.background": "#00a1ff20",
        "renamed.border": "#00a1ff",
        "hidden": "#52494E",
        "hidden.background": "#52494E20",
        "hidden.border": "#52494E",
        "ignored": "#52494E",
        "ignored.background": "#52494E20",
        "ignored.border": "#52494E",
        "unreachable": "#6E666A",
        "unreachable.background": "#52494E20",
        "unreachable.border": "#52494E",
        "predictive": "#6E666A",
        "predictive.background": "#52494E20",
        "predictive.border": "#52494E",

        "players": [
          { "cursor": "#39FF14", "background": "#39FF14", "selection": "#52494E" },
          { "cursor": "#00CC98", "background": "#00CC98", "selection": "#00CC9840" },
          { "cursor": "#9E95C7", "background": "#9E95C7", "selection": "#9E95C740" },
          { "cursor": "#cc8c3c", "background": "#cc8c3c", "selection": "#cc8c3c40" },
          { "cursor": "#00a1ff", "background": "#00a1ff", "selection": "#00a1ff40" },
          { "cursor": "#FFF150", "background": "#FFF150", "selection": "#FFF15040" }
        ],

        "syntax": {
          "comment": { "color": "#cc8c3c" },
          "comment.doc": { "color": "#C7F9AC" },
          "string": { "color": "#C7F9AC" },
          "string.escape": { "color": "#C7F9AC" },
          "string.regex": { "color": "#C7F9AC" },
          "string.special": { "color": "#C7F9AC" },
          "string.special.symbol": { "color": "#C7F9AC" },
          "number": { "color": "#E4E4E4" },
          "boolean": { "color": "#E4E4E4" },
          "constant": { "color": "#9AA999" },
          "function": { "color": "#00CC98" },
          "constructor": { "color": "#00CC98" },
          "preproc": { "color": "#00CC98" },
          "attribute": { "color": "#00CC98" },
          "keyword": { "color": "#39FF14" },
          "label": { "color": "#39FF14" },
          "type": { "color": "#9AA999" },
          "enum": { "color": "#9AA999" },
          "variant": { "color": "#9AA999" },
          "variable": { "color": "#E4E4E4" },
          "variable.special": { "color": "#A3C585" },
          "property": { "color": "#A3C585" },
          "tag": { "color": "#00CC98" },
          "operator": { "color": "#E4E4E4" },
          "punctuation": { "color": "#E4E4E4" },
          "punctuation.bracket": { "color": "#E4E4E4" },
          "punctuation.delimiter": { "color": "#E4E4E4" },
          "punctuation.list_marker": { "color": "#39FF14" },
          "punctuation.special": { "color": "#C7F9AC" },
          "embedded": { "color": "#E4E4E4" },
          "title": { "color": "#39FF14", "font_weight": 700 },
          "emphasis": { "color": "#A3C585", "font_style": "italic" },
          "emphasis.strong": { "color": "#A3C585", "font_weight": 700 },
          "link_text": { "color": "#00CC98" },
          "link_uri": { "color": "#9AA999" },
          "text.literal": { "color": "#C7F9AC" },
          "hint": { "color": "#52494E" },
          "predictive": { "color": "#6E666A", "font_style": "italic" }
        }
      }
    }
  ]
}
