{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"]
}
