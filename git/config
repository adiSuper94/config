[user]
  name = Aditya Subramanian
  email = aditarun2008@gmail.com
  signingkey = ~/.ssh/id_ed25519.pub
[commit]
  gpgsign = true
[gpg]
  format = ssh
[core]
  editor = nvim
  pager = delta
[diff]
  tool = kdiff3
[merge]
  tool = kdiff3
  conflictStyle = zdiff3
[delta]
  navigate = true  # use n and N to move between diff sections
[alias]
  b = branch
  cc = commit
  ca = commit --amend
  co = checkout
  stat = status
  sla = log --oneline --all --graph
  rem = !git checkout --quiet main && git pull --quiet && git checkout - && git rebase main
[init]
  defaultBranch = main
[interactive]
  diffFilter = delta --color-only
